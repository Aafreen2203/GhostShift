# Copy this file to .env.local and replace placeholders.
# Never commit a real connection string or API key.

# Required for the app and seed script
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: OpenAI enrichment for evidence-grounded briefs.
# Without this key, GhostShift still works using MongoDB evidence only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# The app always uses the database name ghostshift.
# Atlas Vector Search index name expected by code: incident_embedding_index
# Dimensions: 384 (cosine), field path: embedding
